"""
لائیو Liquidity Sweep سگنل سکینر
=================================
- بائنانس فیوچرز کے تمام (زیادہ سے زیادہ 500) USDT پرپیچوئل سمبلز خود بخود لے گا
- ہر 15 منٹ بعد نئے سگنلز چیک کرے گا (15m کینڈل کلوز پر)
- SL/TP ایک ہی Risk:Reward ratio پر مبنی ہوں گے (RR نیچے سیٹ کریں)
- نئے سگنلز NTFY پر بھیجے جائیں گے (ٹاپک: ChartMaster786x7k2p9)

پہلے یہ سکرپٹ اپنے سسٹم پر python3 سے چلا کر ٹیسٹ کریں:
    python3 live_signal_scanner.py --once
یہ صرف ایک بار چیک کرے گا اور رک جائے گا (لائیو لوپ شروع نہیں کرے گا)۔
جب تسلی ہو جائے تو بغیر --once کے چلائیں تاکہ یہ ہر 15 منٹ بعد خودکار چیک کرتا رہے۔
"""

import requests
import pandas as pd
import numpy as np
import time
import json
import os
import sys
import argparse

# ============================================================
# سیٹنگز — یہاں سے تبدیل کریں
# ============================================================

MAX_SYMBOLS = 500              # زیادہ سے زیادہ کتنے سمبلز چیک کریں
CHECK_INTERVAL_SECONDS = 900   # 15 منٹ

BUFFER = 0.001
RSI_PERIOD = 9
RSI_OB = 75
RSI_OS = 25
VOL_PERIOD = 20
VOL_MULT = 1.5

RR = 2                         # <<< یہاں Risk:Reward ratio سیٹ کریں (بیک ٹیسٹ میں 1:2 اور 1:3 بہترین رہے)

ENTRY_TIMEFRAME = "15m"        # ہر 15 منٹ چیک کے مطابق انٹری ٹائم فریم بھی 15m رکھا گیا
DAILY_LOOKBACK = 10
H4_LOOKBACK = 20
DAILY_WINDOW_HOURS = 12        # sweep کتنی دیر تک 'active/تازہ' رہے (پہلے 48h تھا — بہت پرانے sweeps پر سگنل بن رہے تھے)
H4_WINDOW_HOURS = 6            # (پہلے 24h تھا)
# نوٹ: یہ windows بیک ٹیسٹ کی 48h/24h سے چھوٹی ہیں، اس لیے لائیو نتائج
# بیک ٹیسٹ کے Win Rate/Net R سے قدرے مختلف ہو سکتے ہیں (کم سگنلز، لیکن زیادہ 'تازہ')

NTFY_TOPIC = "ChartMaster786x7k2p9"
NTFY_URL = f"https://ntfy.sh/{NTFY_TOPIC}"

REQUEST_DELAY = 0.25           # ہر API کال کے بعد وقفہ (rate limit سے بچنے کے لیے)
STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "scanner_state.json")

BASE_URL = "https://fapi.binance.com"


# ============================================================
# مدد گار فنکشنز
# ============================================================

def get_all_symbols(max_symbols=MAX_SYMBOLS):
    """تمام فعال USDT پرپیچوئل فیوچرز سمبلز خودکار طور پر لاتا ہے"""
    url = f"{BASE_URL}/fapi/v1/exchangeInfo"
    try:
        r = requests.get(url, timeout=20)
        data = r.json()
    except Exception as e:
        print("exchangeInfo فیچ نہیں ہو سکا:", e)
        return []

    symbols = []
    for s in data.get("symbols", []):
        if (
            s.get("status") == "TRADING"
            and s.get("contractType") == "PERPETUAL"
            and s.get("quoteAsset") == "USDT"
        ):
            symbols.append(s["symbol"])

    return symbols[:max_symbols]


def get_klines(symbol, interval, limit=150):
    """ایک سمبل کے تازہ ترین کینڈلز لاتا ہے (سادہ سنگل ریکویسٹ - لائیو سکین کے لیے کافی)"""
    url = f"{BASE_URL}/fapi/v1/klines"
    params = {"symbol": symbol, "interval": interval, "limit": limit}

    try:
        r = requests.get(url, params=params, timeout=15)
        data = r.json()
    except Exception as e:
        print(f"{symbol} ({interval}) fetch error:", e)
        return pd.DataFrame()

    if not isinstance(data, list) or len(data) == 0:
        return pd.DataFrame()

    df = pd.DataFrame(data, columns=[
        "time", "open", "high", "low", "close", "volume",
        "close_time", "quote_volume", "trades", "buy_base", "buy_quote", "ignore"
    ])
    df["time"] = pd.to_datetime(df["time"], unit="ms")
    for c in ["open", "high", "low", "close", "volume"]:
        df[c] = pd.to_numeric(df[c])

    df = df[["time", "open", "high", "low", "close", "volume"]]

    # آخری incomplete (ابھی جاری) کینڈل ختم کریں
    if len(df) > 1:
        df = df.iloc[:-1].copy()

    return df.reset_index(drop=True)


def add_indicators(df):
    df = df.copy()
    delta = df["close"].diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(alpha=1 / RSI_PERIOD, min_periods=RSI_PERIOD, adjust=False).mean()
    avg_loss = loss.ewm(alpha=1 / RSI_PERIOD, min_periods=RSI_PERIOD, adjust=False).mean()
    rs = avg_gain / avg_loss
    df["rsi"] = 100 - (100 / (1 + rs))

    df["vol_avg"] = df["volume"].rolling(VOL_PERIOD).mean()
    df["vol_ok"] = df["volume"] >= df["vol_avg"] * VOL_MULT

    return df


def find_sweeps(df, lookback, hours, tf):
    if df.empty or len(df) <= lookback:
        return []

    high = df["high"].values
    low = df["low"].values
    close = df["close"].values
    time_series = df["time"]

    old_high = df["high"].rolling(lookback, min_periods=lookback).max().shift(1).values
    old_low = df["low"].rolling(lookback, min_periods=lookback).min().shift(1).values

    high_mask = (high > old_high) & (close < old_high * (1 - BUFFER))
    low_mask = (low < old_low) & (close > old_low * (1 + BUFFER))
    high_mask = np.nan_to_num(high_mask, nan=False).astype(bool)
    low_mask = np.nan_to_num(low_mask, nan=False).astype(bool)

    sweeps = []
    delta = pd.Timedelta(hours=hours)

    for i in np.where(high_mask)[0]:
        t = time_series.iloc[i]
        sweeps.append({"time": t, "type": "HIGH", "extreme": high[i], "until": t + delta, "tf": tf})

    for i in np.where(low_mask)[0]:
        t = time_series.iloc[i]
        sweeps.append({"time": t, "type": "LOW", "extreme": low[i], "until": t + delta, "tf": tf})

    sweeps.sort(key=lambda x: x["time"])
    return sweeps


def check_latest_signal(entry_df, sweeps):
    """
    صرف سب سے تازہ (آخری بند شدہ) کینڈل پر سگنل چیک کرتا ہے —
    لائیو سکینر کے لیے پوری ہسٹری دوبارہ چیک کرنے کی ضرورت نہیں۔
    """
    if entry_df.empty or len(entry_df) < 2:
        return None

    last = entry_df.iloc[-1]
    t = last["time"]
    r = last["rsi"]

    if pd.isna(r) or pd.isna(last["vol_avg"]):
        return None
    if not last["vol_ok"]:
        return None

    # وقت کے لحاظ سے فعال sweeps تلاش کریں (sweep.time < t <= sweep.until)
    # سب سے تازہ (نئے ترین) sweep کو ترجیح دی جاتی ہے، تاکہ سگنل ہمیشہ
    # سب سے حالیہ liquidity sweep پر بنے، کسی پرانے/باسی sweep پر نہیں
    active = [s for s in sweeps if s["time"] < t <= s["until"]]
    active.sort(key=lambda s: s["time"], reverse=True)

    for sweep in active:
        if sweep["type"] == "LOW":
            if r > RSI_OS:
                continue
            entry = last["close"]
            sl = sweep["extreme"] * (1 - BUFFER)
            risk = entry - sl
            if risk <= 0:
                continue
            tp = entry + risk * RR
            return {"time": t, "side": "LONG", "entry": entry, "sl": sl, "tp": tp, "rr": RR, "sweep_tf": sweep["tf"]}

        else:  # HIGH sweep
            if r < RSI_OB:
                continue
            entry = last["close"]
            sl = sweep["extreme"] * (1 + BUFFER)
            risk = sl - entry
            if risk <= 0:
                continue
            tp = entry - risk * RR
            return {"time": t, "side": "SHORT", "entry": entry, "sl": sl, "tp": tp, "rr": RR, "sweep_tf": sweep["tf"]}

    return None


def load_state():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_state(state):
    try:
        with open(STATE_FILE, "w") as f:
            json.dump(state, f)
    except Exception as e:
        print("state save error:", e)


def send_ntfy(symbol, signal):
    side = signal["side"]
    entry = signal["entry"]
    sl = signal["sl"]
    tp = signal["tp"]
    rr = signal["rr"]

    title = f"{symbol} {side} سگنل"
    message = (
        f"Side: {side}\n"
        f"Entry: {entry:.6f}\n"
        f"SL: {sl:.6f}\n"
        f"TP: {tp:.6f}\n"
        f"RR: 1:{rr}\n"
        f"Sweep TF: {signal['sweep_tf']}\n"
        f"وقت: {signal['time']}"
    )

    try:
        requests.post(
            NTFY_URL,
            data=message.encode("utf-8"),
            headers={
                "Title": title.encode("utf-8"),
                "Priority": "high",
                "Tags": "chart_with_upwards_trend" if side == "LONG" else "chart_with_downwards_trend",
            },
            timeout=10,
        )
        print(f"  -> NTFY بھیج دیا گیا: {symbol} {side}")
    except Exception as e:
        print(f"  -> NTFY بھیجنے میں error: {e}")


# ============================================================
# ایک مکمل سکین سائیکل
# ============================================================

def run_scan_cycle(symbols, state):
    new_signals_count = 0

    for idx, symbol in enumerate(symbols):
        print(f"[{idx+1}/{len(symbols)}] چیک ہو رہا ہے: {symbol}", end="\r")

        daily = get_klines(symbol, "1d", limit=max(DAILY_LOOKBACK + 5, 30))
        time.sleep(REQUEST_DELAY)
        h4 = get_klines(symbol, "4h", limit=max(H4_LOOKBACK + 10, 60))
        time.sleep(REQUEST_DELAY)
        entry_df = get_klines(symbol, ENTRY_TIMEFRAME, limit=60)
        time.sleep(REQUEST_DELAY)

        if daily.empty or h4.empty or entry_df.empty:
            continue

        daily_sweeps = find_sweeps(daily, DAILY_LOOKBACK, DAILY_WINDOW_HOURS, "1D")
        h4_sweeps = find_sweeps(h4, H4_LOOKBACK, H4_WINDOW_HOURS, "4H")
        sweeps = daily_sweeps + h4_sweeps

        if not sweeps:
            continue

        entry_df = add_indicators(entry_df)
        signal = check_latest_signal(entry_df, sweeps)

        if signal is None:
            continue

        # ڈپلیکیٹ چیک: کیا اس exact کینڈل ٹائم پر پہلے ہی نوٹیفیکیشن جا چکی ہے؟
        signal_key = f"{symbol}_{signal['time'].isoformat()}"
        if state.get(symbol) == signal_key:
            continue  # پہلے سے بھیجا جا چکا

        send_ntfy(symbol, signal)
        state[symbol] = signal_key
        new_signals_count += 1

    print(" " * 80, end="\r")  # progress line صاف کریں
    return new_signals_count


# ============================================================
# مین
# ============================================================

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true", help="صرف ایک بار چیک کریں اور رک جائیں (ٹیسٹنگ کے لیے)")
    parser.add_argument("--test-notify", action="store_true", help="صرف ایک ٹیسٹ نوٹیفیکیشن بھیجیں اور رک جائیں")
    args = parser.parse_args()

    if args.test_notify:
        print("ٹیسٹ نوٹیفیکیشن بھیجی جا رہی ہے...")
        send_ntfy("TESTUSDT", {
            "time": pd.Timestamp.now(), "side": "LONG", "entry": 100.0,
            "sl": 99.0, "tp": 102.0, "rr": RR, "sweep_tf": "4H",
        })
        print(f"ntfy.sh/{NTFY_TOPIC} پر چیک کریں (یا NTFY ایپ میں یہ ٹاپک subscribe کریں)۔")
        return

    print("=" * 65)
    print("LIVE LIQUIDITY SWEEP SIGNAL SCANNER")
    print(f"RR: 1:{RR} | Entry TF: {ENTRY_TIMEFRAME} | NTFY Topic: {NTFY_TOPIC}")
    print("=" * 65)

    print("\nسمبلز کی فہرست لائی جا رہی ہے...")
    symbols = get_all_symbols(MAX_SYMBOLS)
    print(f"{len(symbols)} سمبلز ملے۔\n")

    if not symbols:
        print("کوئی سمبل نہیں ملا — انٹرنیٹ کنکشن یا Binance API چیک کریں۔")
        return

    state = load_state()

    if args.once:
        print("ایک بار چیک کیا جا رہا ہے (--once موڈ)...\n")
        count = run_scan_cycle(symbols, state)
        save_state(state)
        print(f"\nمکمل — {count} نئے سگنلز ملے اور بھیجے گئے۔")
        return

    print(f"لائیو موڈ شروع — ہر {CHECK_INTERVAL_SECONDS//60} منٹ بعد چیک ہوگا۔ روکنے کے لیے Ctrl+C دبائیں۔\n")

    while True:
        cycle_start = time.time()
        now = pd.Timestamp.now()
        print(f"\n--- سکین سائیکل: {now} ---")

        count = run_scan_cycle(symbols, state)
        save_state(state)

        print(f"سائیکل مکمل — {count} نئے سگنلز بھیجے گئے۔")

        elapsed = time.time() - cycle_start
        sleep_time = max(0, CHECK_INTERVAL_SECONDS - elapsed)
        print(f"اگلا چیک {sleep_time/60:.1f} منٹ بعد...")
        time.sleep(sleep_time)


if __name__ == "__main__":
    main()
    
